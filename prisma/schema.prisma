// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id           String    @id @default(cuid())
  company_name String
  website      String?
  domain       String?   @unique
  city         String?
  state        String?
  country      String    @default("US")
  source       String
  category     String?
  created_at   DateTime  @default(now())
  contacts     Contact[]
}

model Contact {
  id           String    @id @default(cuid())
  lead         Lead      @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  lead_id      String
  name         String?
  title        String?
  email        String    @unique
  email_status String    @default("unverified") // unverified|valid|risky|invalid
  confidence   Int?
  source       String?
  messages     Message[]
}

model Campaign {
  id            String    @id @default(cuid())
  name          String
  subject       String
  body_template String
  from_name     String
  from_email    String
  status        String    @default("draft") // draft|sending|done
  created_at    DateTime  @default(now())
  messages      Message[]
}

model Message {
  id                  String    @id @default(cuid())
  campaign            Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  campaign_id         String
  contact             Contact   @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  contact_id          String
  status              String    @default("queued") // queued|sent|delivered|bounced|failed
  provider_message_id String?
  sent_at             DateTime?
  created_at          DateTime  @default(now())
}

model SuppressionList {
  id         String   @id @default(cuid())
  email      String   @unique
  reason     String   // unsubscribed|bounced|complaint
  created_at DateTime @default(now())
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
