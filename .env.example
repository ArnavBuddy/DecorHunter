# Database (Neon / Supabase / local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/homedecor?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (for the simple credentials provider)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"

# Lead Discovery APIs
GOOGLE_PLACES_KEY=""
HUNTER_KEY=""
APOLLO_KEY=""
ZEROBOUNCE_KEY=""
YELP_KEY=""

# Email Sending
RESEND_KEY=""

# Compliance — DRY_RUN=true redirects ALL emails to DRY_RUN_EMAIL
DRY_RUN="true"
DRY_RUN_EMAIL="your-test-inbox@example.com"

# CAN-SPAM: physical postal address included in every email footer
PHYSICAL_ADDRESS="123 Main St, Suite 100, New York, NY 10001"

# Sending limits
SEND_DELAY_MS="3000"
DAILY_SEND_CAP="50"

# Unsubscribe token signing
UNSUBSCRIBE_SECRET="change-this-secret"
